# ============================================================
# accuretta — production-safe gitignore
# anything in ./data is user-local (chats, keys, workspace paths,
# machine scan, model choice). never commit it.
# ============================================================

# runtime user data — all of it is per-machine and often sensitive
data/*
!data/.gitkeep

# llama.cpp builds the setup wizard or "Update llama.cpp" downloaded, and the
# Maya engine "Install Maya" set up
/bin/
# the Maya package builder's work and output (tools/maya-package/build.ps1)
tools/maya-package/build/
tools/maya-package/dist/

# python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.venv/
venv/
env/
.env
.env.*
!.env.example

# node / editor / ai tools cruft (in case we add any tooling later)
node_modules/
.vscode/
.idea/
.claude/
.cursor/
.cline/
modelfiles/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini
start.lnk

# build / logs
*.log
*.tmp
dist/
# ...except vendored library builds the app loads (html2canvas, jszip)
!assets/vendor/*/dist/
build/
coverage/

# local design drafts that aren't part of the shipped app
pretune.py
splash_preview.html
.playwright-mcp/

# accuretta-specific safety net — if any of these sneak outside ./data
ACCURETTA.md
chats.json
settings.json
workspace.json
approvals.json
versions/

# MCP server config — holds API keys (Shodan, VirusTotal, etc.). Local per-machine.
bridge_mcp_config.json

# email plugin — the skill and scripts ship; the config (account, password, contacts)
# and the pre-split originals stay on this machine.
email_plugin/email_config.json*
email_plugin/before-split/

# working copy of the motion-graphics skill; the shipped one is skill_assets/
/code-driven-motion-graphics/

# user-curated skills (markdown procedures) — per-machine, may name local paths
skills/

# user workspace content — kept out of git, same reason as ./data
Workspace/

# red-team test artifacts (curl login probes etc.) — never commit session data
body.txt
cookies.txt
headers.txt
login_resp.txt

# runtime stats database — regenerated by the app, never commit
github_stats.db

# Local release and design work that is not part of the app.
promo_video/
AUDIT_AND_ROADMAP.md

# The test suite is public; these parts of tests/ stay private: old file
# snapshots (they hold personal paths), screenshots, dev scripts and notes.
tests/baseline/
tests/dev-checks/
tests/*.png
tests/VERIFICATION.md
# Local test rigs and benchmark runs, never shipped
bench/

# launch videos and pages: large or one-off, kept local
assets/social/*.mp4
assets/social/v*-launch.html

# Windows installer build output
tools/installer/build/
tools/installer/dist/
tools/installer/cache/
